{
  "schema_version": "2.0",
  "dataset_id": "coding-v3-idempotent-ledger-pilot",
  "description": "Pre-registered hidden cases for an idempotent transfer event state machine.",
  "tasks": [
    {
      "task_id": "idempotent-ledger-001",
      "category": "business-state-machine",
      "difficulty": "hard",
      "prompt": "实现 Python 函数 process_idempotent_transfers(initial_balances, events)。initial_balances 是账户名到非负整数余额的字典。每个 event 必须且只能包含 id、from、to、amount：前三者为非空字符串，from 与 to 不同，amount 为正整数。首次出现的 id：若来源余额不足，状态为 rejected 且不改变余额；否则执行转账，必要时创建目标账户，状态为 applied。每个结果为 {id, status, from_balance, to_balance}，余额字段是该事件首次处理后的两个账户余额。重复 id 且载荷完全相同必须返回首次缓存的结果，绝不能再次执行，即使余额后来发生变化；重复 id 但 from/to/amount 任一不同必须抛出 ValueError。返回 {results: 按输入事件顺序的结果列表, balances: 最终余额字典}。缺失来源账户按余额 0 处理。非法初始余额、非法事件、冲突幂等键均抛出 ValueError。不得修改输入或使用全局状态。",
      "evaluation_suite": {
        "function_name": "process_idempotent_transfers",
        "test_cases": [
          {
            "args": [
              {"a": 10, "b": 0, "c": 0},
              [
                {"id": "e1", "from": "a", "to": "b", "amount": 7},
                {"id": "e2", "from": "b", "to": "c", "amount": 5},
                {"id": "e1", "from": "a", "to": "b", "amount": 7}
              ]
            ],
            "expected": {
              "results": [
                {"id": "e1", "status": "applied", "from_balance": 3, "to_balance": 7},
                {"id": "e2", "status": "applied", "from_balance": 2, "to_balance": 5},
                {"id": "e1", "status": "applied", "from_balance": 3, "to_balance": 7}
              ],
              "balances": {"a": 3, "b": 2, "c": 5}
            },
            "expected_exception": null,
            "description": "duplicate applied event returns cached result without reapplying"
          },
          {
            "args": [
              {"a": 1},
              [
                {"id": "missing", "from": "x", "to": "z", "amount": 1}
              ]
            ],
            "expected": {
              "results": [
                {"id": "missing", "status": "rejected", "from_balance": 0, "to_balance": 0}
              ],
              "balances": {"a": 1}
            },
            "expected_exception": null,
            "description": "missing source has zero balance and rejection creates no accounts"
          },
          {
            "args": [
              {"a": 2},
              [
                {"id": "new-destination", "from": "a", "to": "z", "amount": 2}
              ]
            ],
            "expected": {
              "results": [
                {"id": "new-destination", "status": "applied", "from_balance": 0, "to_balance": 2}
              ],
              "balances": {"a": 0, "z": 2}
            },
            "expected_exception": null,
            "description": "successful transfer creates a missing destination"
          },
          {
            "args": [
              {"a": 3},
              []
            ],
            "expected": {
              "results": [],
              "balances": {"a": 3}
            },
            "expected_exception": null,
            "description": "empty event list returns an independent balance copy"
          },
          {
            "args": [
              {"a": 10, "b": 0, "c": 0},
              [
                {"id": "same", "from": "a", "to": "b", "amount": 2},
                {"id": "same", "from": "a", "to": "c", "amount": 2}
              ]
            ],
            "expected": null,
            "expected_exception": "ValueError",
            "description": "same id with a conflicting destination is rejected"
          },
          {
            "args": [
              {"a": -1},
              []
            ],
            "expected": null,
            "expected_exception": "ValueError",
            "description": "negative initial balances are rejected"
          },
          {
            "args": [
              {"a": 2, "b": 0},
              [
                {"id": "zero", "from": "a", "to": "b", "amount": 0}
              ]
            ],
            "expected": null,
            "expected_exception": "ValueError",
            "description": "zero transfer amount is rejected"
          },
          {
            "args": [
              {"a": 2},
              [
                {"id": "self", "from": "a", "to": "a", "amount": 1}
              ]
            ],
            "expected": null,
            "expected_exception": "ValueError",
            "description": "self transfer is rejected"
          }
        ]
      }
    }
  ]
}
