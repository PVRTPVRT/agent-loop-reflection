{
  "schema_version": "2.0",
  "dataset_id": "coding-v2-repair-routing",
  "description": "Pre-registered public routing cases for the v0.2 evidence-driven repair pilot.",
  "tasks": [
    {
      "task_id": "ttl-lru-001",
      "category": "state-machine",
      "difficulty": "hard",
      "prompt": "Public routing suite",
      "evaluation_suite": {
        "function_name": "simulate_ttl_lru",
        "test_cases": [
          {
            "args": [
              2,
              [
                {"op": "put", "key": "a", "value": "A", "ttl": 2, "time": 0},
                {"op": "put", "key": "b", "value": "B", "ttl": 10, "time": 0},
                {"op": "get", "key": "a", "time": 1},
                {"op": "put", "key": "c", "value": "C", "ttl": 10, "time": 2},
                {"op": "get", "key": "a", "time": 2},
                {"op": "get", "key": "b", "time": 2},
                {"op": "get", "key": "c", "time": 2}
              ]
            ],
            "expected": ["A", null, "B", "C"],
            "expected_exception": null,
            "description": "expiry occurs before LRU eviction at the same timestamp"
          },
          {
            "args": [
              1,
              [
                {"op": "put", "key": "x", "value": "old", "ttl": 1, "time": 0},
                {"op": "put", "key": "x", "value": "new", "ttl": 5, "time": 1},
                {"op": "get", "key": "x", "time": 5},
                {"op": "get", "key": "x", "time": 6}
              ]
            ],
            "expected": ["new", null],
            "expected_exception": null,
            "description": "overwrite resets value, recency, and expiry"
          }
        ]
      }
    }
  ]
}
