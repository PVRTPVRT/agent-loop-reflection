# Copy these values into your terminal environment. Do not commit real keys.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna
MAX_DEBATE_ROUNDS=2
MAX_CODING_ROUNDS=3

# Optional OpenTelemetry / Phoenix export. Disabled by default.
AGENTLOOP_OTEL_ENABLED=false
AGENTLOOP_OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=agent-loop-reflection
PHOENIX_PROJECT_NAME=agent-loop-reflection

